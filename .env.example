# The Nilgiri Root — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Where to get these:
#   Supabase Dashboard -> Project Settings -> API
#   https://supabase.com/dashboard/project/gmuprayrdyghdmvrxrss/settings/api

# ─── Client-side (bundled into the browser build) ──────────────────────────
# Only ever put publishable/anon values in VITE_* variables. Vite inlines them
# into the JavaScript bundle, so anything here is public by definition.

VITE_SUPABASE_URL=https://gmuprayrdyghdmvrxrss.supabase.co
VITE_SUPABASE_PROJECT_ID=gmuprayrdyghdmvrxrss
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Build-time only (not exposed to the browser) ──────────────────────────
# Used by scripts/generate-sitemap.mjs to read published blog posts.

SUPABASE_URL=https://gmuprayrdyghdmvrxrss.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ─── NEVER put these in this file ──────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security entirely. It belongs
# only in Supabase Edge Function secrets, where it is injected automatically —
# the functions in supabase/functions/ read it from Deno.env at runtime and it
# never needs to exist on a developer machine or in Vercel.
